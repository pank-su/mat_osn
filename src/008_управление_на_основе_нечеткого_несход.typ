    $alpha_2$, $beta_2$, $gamma_2$, $R_3$,
  )
)

$x, y, z$ - производственная ситуации
$Rho_1, Rho_2, Rho_3$ - классы произв. ситуаций соответствующее управляюмым решениям $R_1, R_2, R_3$

$
  mu_(Rho_1)(x, y, z) = mu_(alpha_1)(x) and mu_(beta_1)(y) and mu_(gamma_1)(z) or mu_(alpha_1)(x) and mu_(beta_1)(y) and mu_(gamma_2)(z) or \
  or mu_(alpha_2)(x) and mu_(beta_1)(y) and mu_(gamma_1)(z) or mu_(alpha_2)(x) and mu_(beta_1)(y) and mu_(gamma_2)(z),
$

$
  mu_(Rho_2)(x, y, z) = mu_(alpha_1)(x) and mu_(beta_2)(y) and mu_(gamma_1)(z) or mu_(alpha_1)(x) and mu_(beta_2)(y) and \
  and mu_(gamma_2)(z) or mu_(alpha_2)(x) and mu_(beta_2)(y) and mu_(gamma_1)(z),
$

$
  mu_(Rho_3)(x, y, z) = mu_(alpha_2)(x) and mu_(beta_2)(y) and mu_(gamma_2)(z).
$

